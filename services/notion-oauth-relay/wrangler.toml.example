# Cloudflare Workers deployment for Wren's Notion OAuth relay (maintainers only).
# Copy to wrangler.toml, then set secrets (never commit them):
#   wrangler secret put NOTION_CLIENT_ID
#   wrangler secret put NOTION_CLIENT_SECRET
#   wrangler secret put PUBLIC_URL        # e.g. https://wren-notion-relay.<account>.workers.dev
name = "wren-notion-relay"
main = "relay.mjs"
compatibility_date = "2026-10-01"
workers_dev = true
[observability]
enabled = false
