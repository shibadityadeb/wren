# Wren provider settings: for Wren's maintainers only. Users never see or edit this.
# Copy to config/providers.env (git-ignored) or set these as CI secrets/variables, then run
# scripts/build-app.sh. ChatGPT and Notion need nothing here: Wren registers itself with them.
# See docs/MAINTAINER_SETUP.md.

# Google OAuth client of type "Desktop app" (Gmail, Calendar). Installed-app flow with PKCE + state.
WREN_GOOGLE_CLIENT_ID=
# The same Desktop client's secret. Google's token endpoint requires it for Desktop clients (it answers
# "client_secret is missing" without it) and documents installed-app secrets as not confidential: it's
# embedded in the app bundle, never committed to git and never shown to users.
WREN_GOOGLE_CLIENT_SECRET=

# Where Wren's Google app is in Google's process, so Wren tells users what to expect:
#   testing     only the test users you listed can connect; Google asks them to reconnect every 7 days
#   unverified  published but not verified: anyone can connect (up to 100 users) after Google's
#               "Google hasn't verified this app" screen (Advanced › Go to Wren)
#   verified    Google approved the verification
WREN_GOOGLE_STATUS=testing
