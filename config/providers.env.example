# Wren provider registrations: for Wren's maintainers only. Users never see or edit this.
# Copy to config/providers.env (git-ignored) or set these as CI secrets, then run
# scripts/build-app.sh. Leave a value empty to build without that provider.
# See docs/MAINTAINER_SETUP.md.

# Google OAuth client of type "Desktop app" (Gmail read-only, Calendar read-only). Only the client ID:
# Wren uses the installed-app flow with PKCE and never ships or sends a client secret.
WREN_GOOGLE_CLIENT_ID=

# Notion public integration. The client secret is NOT here: it lives only in the relay service.
WREN_NOTION_CLIENT_ID=
# HTTPS base URL of the deployed relay (services/notion-oauth-relay), e.g. https://notion-relay.example.com
WREN_NOTION_OAUTH_RELAY=
